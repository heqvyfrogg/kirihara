# 桐原書店 ログイン設定
KIRIHARA_ACCOUNT_NAME=your_student_account_name
KIRIHARA_PASSWORD=your_student_password

# Gemini API 設定
GEMINI_API_KEY=your_gemini_api_key_here
# 使用するGeminiモデル (デフォルト: gemini-flash-latest, 例: gemini-3.5-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# 任意: Cookieを直接指定する場合
SESSION_COOKIE=

